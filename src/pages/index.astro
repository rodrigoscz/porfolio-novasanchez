---
import "../styles/theme.css";

const profile = {
  name: "Rodrigo Sánchez",
  displayName: "Rodrigo",
  handle: "@rodrigoscz_",
  role: "Dev y SEO técnico",
  thesis: "Todo es lenguaje.",
  intro:
    "El código, el SEO, los reportes, los menús, los datos y las respuestas de un LLM. " +
    "Soy Rodrigo, dev y SEO técnico desde el NEA. Construyo webapps e investigaciones para entender cómo las máquinas y las personas interpretan lo que publicamos.",
  email: "rodrigoscz.dev@gmail.com",
  x: "https://x.com/rodrigoscz_",
  github: "https://github.com/rodrigoscz",
};

// Las herramientas de la suite. href apunta al subdominio planeado;
// repo queda como fallback verificable hasta que los subdominios esten cableados.
const suite = [
  {
    name: "tres-lenguas",
    tagline: "Un audit web, tres lentes.",
    desc: "Traduce un informe SEO o técnico a las voces de Técnico, CMO y CFO. Cliente puro, sin backend.",
    href: "https://tres-lenguas.novasanchez.com",
    repo: "https://github.com/rodrigoscz/tres-lenguas",
  },
  {
    name: "tropicaliza",
    tagline: "El español no es uno solo.",
    desc: "Linter de locale: marca rioplatensismos, calcos y registros que no viajan entre variantes del español.",
    href: "https://tropicaliza.novasanchez.com",
    repo: "https://github.com/rodrigoscz/tropicaliza",
  },
  {
    name: "nav-sense",
    tagline: "La navegación también comunica.",
    desc: "Analiza la arquitectura de información de un sitio y señala dónde el menú confunde en vez de guiar.",
    href: "https://nav-sense.novasanchez.com",
    repo: "https://github.com/rodrigoscz/nav-sense",
  },
  {
    name: "lang-forge",
    tagline: "El laboratorio de la suite.",
    desc: "Banco de experimentos e investigación donde maduran las ideas que después se vuelven herramientas.",
    href: "https://lab.novasanchez.com",
    repo: "https://github.com/rodrigoscz/lang-forge",
  },
];

const pageTitle = `${profile.name} · ${profile.role} · ${profile.thesis}`;
const pageDescription =
  "Portfolio de Rodrigo Sánchez (rodrigoscz), dev y SEO técnico. Casa de la suite open-source «todo es lenguaje»: herramientas para entender cómo las máquinas y las personas interpretan lo que publicamos.";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL("/og.png", Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: "rodrigoscz",
  url: canonicalUrl,
  image: ogImageUrl,
  jobTitle: profile.role,
  description: profile.intro,
  email: `mailto:${profile.email}`,
  sameAs: [profile.x, profile.github],
  knowsAbout: [
    "SEO técnico",
    "Desarrollo web",
    "Lingüística aplicada",
    "Modelos de lenguaje",
    "Arquitectura de la información",
  ],
};
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <!-- El badge, no el mark transparente: el skin del mark es #e7cda6, que es
         exactamente el fondo claro, así que sobre una barra de pestañas clara la
         cabeza desaparece. El badge trae tile #0d1117. Igual que los otros 4 repos. -->
    <link rel="icon" type="image/svg+xml" href="/nova-mark-badge.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/sentient.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/rajdhani.woff2"
      crossorigin
    />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.name}, ${profile.role}. ${profile.thesis}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={profile.handle} />
    <meta name="twitter:creator" content={profile.handle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <div class="site-actions">
      <nav class="topnav" aria-label="Navegación principal">
        <a href="#sobre-mi">sobre mí</a>
        <a href="#suite">la suite</a>
        <a href="#contacto">contacto</a>
      </nav>
    </div>

    <main id="contenido">
      <header class="hero">
        <span class="hero-mark">
          <img src="/nova-mark.svg" width="120" height="120" alt="" />
        </span>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="thesis">{profile.thesis}</p>
        <p class="sub">
          {profile.intro}
          <a href="https://x.com/rodrigoscz_">{profile.handle}</a>
        </p>
      </header>

      <section id="sobre-mi">
        <h2>&gt; sobre mí</h2>
        <p>
          Me interesa la parte invisible del trabajo digital: cómo una auditoría
          se convierte en una decisión, cómo una estructura semántica guía a un
          algoritmo, cómo un reporte deja de ser ruido y empieza a decir algo
          útil.
        </p>
        <p>
          Durante años el marketing digital llenó carpetas de reportes que
          alguien tenía que traducir para que un CMO o un CEO pudiera decidir
          algo. Hoy el problema es más grande: también tenemos que ser
          entendidos por modelos, buscadores y sistemas que interpretan señales.
        </p>
        <p>
          Ahí está mi lugar: convertir ruido técnico en sentido. Con webapps,
          datasets, investigación y código abierto.
        </p>
        <ul class="stack">
          <li>Python · SQL · DataForSEO</li>
          <li>TypeScript · Astro · Vite</li>
          <li>Ingeniería de LLMs · SEO técnico · semántica</li>
        </ul>
      </section>

      <section id="suite">
        <h2>&gt; la suite «todo es lenguaje»</h2>
        <p class="section-intro">
          Herramientas open-source, 100 % del lado del cliente, que tratan el
          lenguaje como materia prima. Cada una resuelve un problema concreto.
        </p>
        <div class="cards">
          {
            suite.map((tool) => (
              <article class="card">
                <h3>
                  <a href={tool.href}>{tool.name}</a>
                </h3>
                <p class="card-tagline">{tool.tagline}</p>
                <p class="card-desc">{tool.desc}</p>
                <p class="card-links">
                  <a
                    class="card-cta"
                    href={tool.href}
                    aria-label={`Ver proyecto ${tool.name}`}
                  >
                    Ver proyecto
                  </a>
                  <a
                    class="card-code"
                    href={tool.repo}
                    aria-label={`Ver repositorio de ${tool.name}`}
                  >
                    Ver repositorio
                  </a>
                </p>
              </article>
            ))
          }
        </div>
        <p class="suite-hub">
          Índice completo de la suite en
          <a href="https://github.com/rodrigoscz/lang-suite">lang-suite</a>.
        </p>
      </section>

      <section id="contacto">
        <h2>&gt; contacto</h2>
        <p>
          Si trabajas en SEO, desarrollo o lenguaje aplicado a LLMs, conversemos.
        </p>
        <p class="contact-links">
          <a href={profile.github}>github</a>
          <a href={profile.x}>{profile.handle}</a>
          <a href={`mailto:${profile.email}`}>mail</a>
        </p>
      </section>

      <footer>
        <p class="suite">
          <img src="/nova-mark.svg" width="16" height="16" alt="" />
          {profile.name} · casa de la suite «todo es lenguaje» ·
          <a href="https://x.com/rodrigoscz_">{profile.handle}</a> ·
          <a href="https://github.com/rodrigoscz">github</a>
        </p>
      </footer>
    </main>

    <style is:global>
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--arena);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1.05rem;
        line-height: 1.65;
      }
      h1,
      h2,
      h3 {
        font-family: var(--font-title);
        font-weight: 700;
      }

      /* Un anillo de foco único para todo lo interactivo. Sin esto, quien
         navega con teclado no tiene ninguna señal de dónde está parado. */
      :focus-visible {
        outline: 2px solid var(--terra);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 20;
        padding: 0.5rem 0.9rem;
        background: var(--paper);
        border: 1px solid var(--terra);
        border-radius: 8px;
        color: var(--terra);
        font-size: 0.85rem;
        text-decoration: none;
        transform: translateY(-150%);
      }
      .skip-link:focus {
        transform: translateY(0);
      }

      /* El nav es fixed: sin esto el encabezado queda tapado al saltar a un ancla. */
      section[id],
      main[id] {
        scroll-margin-top: 5rem;
      }

      main {
        max-width: 820px;
        margin: 0 auto;
        padding: 4.5rem 1.25rem 4rem;
      }
      .site-actions {
        position: fixed;
        top: 0.9rem;
        right: 0.9rem;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 1rem;
        background: color-mix(in srgb, var(--arena) 88%, transparent);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 0.35rem;
        backdrop-filter: blur(10px);
      }
      .hero {
        text-align: center;
        padding: 1rem 0 1.5rem;
      }
      .hero-mark {
        display: inline-block;
      }
      .hero img {
        display: block;
      }
      h1 {
        font-size: clamp(1.9rem, 8vw, 2.4rem);
        margin: 0.4rem 0 0;
        letter-spacing: 0.04em;
      }
      .role {
        margin: 0.35rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        letter-spacing: 0.12em;
        text-transform: lowercase;
        color: var(--brown);
        text-align: center;
      }
      .thesis {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--terra);
        margin: 0.6rem 0 0.3rem;
        text-align: center;
      }
      .sub {
        color: var(--brown);
        max-width: 58ch;
        margin: 0.6rem auto 0;
      }
      .hero a {
        color: var(--terra);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .hero a:hover {
        border-bottom-color: var(--terra);
      }
      .topnav {
        display: flex;
        gap: 0.85rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .topnav a {
        color: var(--brown);
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        border-bottom: 1px solid transparent;
      }
      .topnav a:hover {
        color: var(--terra);
        border-bottom-color: var(--terra);
      }
      h2 {
        font-size: 1.3rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--brown);
        border-bottom: 2px solid var(--line);
        padding-bottom: 0.3rem;
        margin: 2.6rem 0 1rem;
      }
      /* Sin restricción propia: el ancho de lectura lo define el contenedor
         `main`, igual que las cards y los chips. Un max-width acá dejaba las
         secciones de texto más angostas que todo lo que las rodea. */
      section p {
        max-width: none;
      }
      .section-intro {
        color: var(--brown);
      }
      .stack {
        list-style: none;
        padding: 0;
        margin: 1.8rem 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .stack li {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 0.3rem 0.7rem;
        color: var(--brown);
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 0.5rem;
      }
      .card {
        background: var(--paper);
        border: 2px solid var(--line);
        border-radius: 10px;
        padding: 1rem 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .card:hover {
        border-color: var(--terra);
      }
      .card h3 {
        margin: 0;
        font-size: 1.3rem;
        letter-spacing: 0.03em;
      }
      .card h3 a {
        color: var(--ink);
        text-decoration: none;
      }
      .card h3 a:hover {
        color: var(--terra);
      }
      .card-tagline {
        margin: 0;
        color: var(--terra);
        font-weight: 700;
        font-size: 0.95rem;
      }
      .card-desc {
        margin: 0;
        color: var(--brown);
        font-size: 0.92rem;
      }
      /* La acción primaria (abrir la herramienta) y la secundaria (ver el repo)
         iban idénticas y se leían como dos links del mismo peso. Ahora la
         primaria es un botón y la secundaria queda como link de texto. */
      /* `margin-top: auto` alinea las acciones al pie de cada card, aunque las
         descripciones tengan distinto largo. */
      .card-links {
        margin: 0.9rem 0 0;
        margin-top: auto;
        padding-top: 0.9rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.9rem;
      }
      .card-cta {
        font-family: var(--font-title);
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-decoration: none;
        background: var(--terra);
        color: var(--arena);
        padding: 0.3rem 0.9rem;
        border-radius: 6px;
        border: 1px solid var(--terra);
      }
      .card-cta:hover {
        background: transparent;
        color: var(--terra);
      }
      .card-code {
        color: var(--brown);
        text-decoration: none;
        border-bottom: 1px solid var(--line);
      }
      .card-code:hover {
        color: var(--terra);
        border-bottom-color: var(--terra);
      }
      .suite-hub {
        margin-top: 1.2rem;
        font-size: 0.85rem;
        color: var(--brown);
      }
      .suite-hub a,
      #contacto a,
      footer a {
        color: var(--terra);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .suite-hub a:hover,
      #contacto a:hover,
      footer a:hover {
        border-bottom-color: var(--terra);
      }
      .contact-links {
        display: flex;
        gap: 1.2rem;
        flex-wrap: wrap;
        margin-top: 0.6rem;
      }
      strong {
        color: var(--ink);
      }
      footer {
        margin-top: 3.5rem;
        font-size: 0.78rem;
        color: var(--brown);
        text-align: center;
      }
      .suite {
        opacity: 0.95;
      }
      .suite img {
        vertical-align: -3px;
        margin-right: 0.35rem;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        * {
          animation: none !important;
          transition: none !important;
        }
      }
      @media (max-width: 640px) {
        main {
          padding-top: 7rem;
        }
        .site-actions {
          left: 0.75rem;
          right: 0.75rem;
          justify-content: space-between;
        }
        .topnav {
          gap: 0.65rem;
        }
        .topnav a {
          font-size: 0.75rem;
        }
        section[id],
        main[id] {
          scroll-margin-top: 7.5rem;
        }
        .cards {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
